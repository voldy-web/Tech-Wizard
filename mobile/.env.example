# Copy to .env and edit. On a real phone running Expo Go this MUST be your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.50:8080

# Frontend-only testing: set to true to use built-in fake data instead of the Java backend.
EXPO_PUBLIC_USE_MOCK=false

# Hosted backend (Render): URL of your service and the API_KEY value from its Environment tab.
# EXPO_PUBLIC_API_URL=https://tech-wizard-api.onrender.com
# EXPO_PUBLIC_API_KEY=paste-the-key-here
