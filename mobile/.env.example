# Where the app keeps its data:
#   local = on the phone itself, works fully offline (default - no server needed)
#   cloud = the hosted Java backend (then API_URL and API_KEY below are used)
EXPO_PUBLIC_DATA_MODE=local

# --- only for DATA_MODE=cloud ---
# On a real phone with Expo Go the URL must be a LAN IP (http://192.168.x.x:8080) or the hosted URL, never localhost.
# EXPO_PUBLIC_API_URL=https://tech-wizard-api.onrender.com
# EXPO_PUBLIC_API_KEY=paste-the-key-here
